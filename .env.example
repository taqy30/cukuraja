NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# URL kanonik aplikasi (CSRF allowlist Origin/Referer) — WAJIB di production
# Contoh Vercel: https://cukuraja.vercel.app  (tanpa trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tampilkan tombol akun demo di UI (default: hanya non-production)
# JANGAN set true di production publik
# NEXT_PUBLIC_ENABLE_DEMO=true

# Izinkan createUser tanpa konfirmasi email (default: hanya non-production)
# ALLOW_UNVERIFIED_SIGNUP=true

# Self-serve daftar bisnis baru (default: hanya non-production)
# ENABLE_BUSINESS_REGISTER=true

# --- Rate limit terdistribusi (SANGAT DISARANKAN di Vercel) ---
# Tanpa ini, limit hanya in-memory per serverless instance → brute-force login
# hampir tidak tertahan. Buat database Redis di https://upstash.com lalu isi:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
